# Public site address: canonical links, sitemap.xml, schema.org
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Servers: the same address, read at start-up (one image for staging and production)
SITE_URL=
# Staging: 1 = robots.txt closes the whole site
SITE_NOINDEX=
# API for the browser (through the /api rewrite) and for the server
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional: API address inside Docker for server-side rendering, e.g. http://api:8000
API_INTERNAL_URL=
