NEXT_PUBLIC_SITE_URL=http://localhost:3000
# API for the browser (through the /api rewrite) and for the server
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional: API address inside Docker for server-side rendering, e.g. http://api:8000
API_INTERNAL_URL=
