# Copy to /opt/ups-kulka/env/staging.env on the server and fill in. Never commit the real file.
DEPLOY_ENV=staging
IMAGE_PREFIX=ghcr.io/volodymyrdominion12/ups-kulka
# Media and backups on the host; must be owned by uid 10001 (see docs/runbook.md)
DATA_DIR=/srv/ups-kulka/staging
SITE_URL=https://staging.example.ua
SITE_NOINDEX=1

# openssl rand -hex 24
POSTGRES_PASSWORD=
# Admin panel login password
UPS_ADMIN_PASSWORD=
# openssl rand -hex 32
UPS_ADMIN_SECRET_KEY=

# Empty = online payment is off (customers pay on pickup / on delivery)
UPS_MONOBANK_TOKEN=
# Empty = order notifications go only to the log
UPS_TELEGRAM_BOT_TOKEN=
UPS_TELEGRAM_CHAT_ID=

BACKUP_KEEP_DAYS=3
