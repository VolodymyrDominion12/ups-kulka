# Copy to /opt/ups-kulka/env/edge.env on the server.
# Let's Encrypt account email (certificate expiry warnings)
ACME_EMAIL=
SITE_DOMAIN=example.ua
STAGING_DOMAIN=staging.example.ua
# The old site's domain; enable "old-domain" below only after its DNS points here
OLD_DOMAIN=oops.kylka.shop
# Which files from edge/sites-available Caddy serves
EDGE_SITES="production staging"
DATA_ROOT=/srv/ups-kulka
