{$STAGING_DOMAIN} {
	import common
	header X-Robots-Tag "noindex, nofollow"

	handle /media/* {
		root * /srv/ups-kulka/staging
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle /api/* {
		reverse_proxy staging-api:8000
	}
	handle {
		reverse_proxy staging-web:3000
	}
}
