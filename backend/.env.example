UPS_ENVIRONMENT=local
UPS_DATABASE_URL=postgresql+asyncpg://ups:ups@localhost:5432/ups_kulka
UPS_SQL_ECHO=false
# Optional: run integration tests against an existing database instead of testcontainers
# TEST_DATABASE_URL=postgresql+asyncpg://ups:ups@localhost:5432/ups_kulka_test

# Public site URL: payment redirect and webhook addresses (specs/006)
UPS_PUBLIC_BASE_URL=http://localhost:3000
# monobank acquiring token; empty = online payment is off (specs/006)
UPS_MONOBANK_TOKEN=
# Telegram notifications for the shop (specs/008); get the chat id with scripts/telegram_chat_id.py
UPS_TELEGRAM_BOT_TOKEN=
UPS_TELEGRAM_CHAT_ID=
